# Fleet Management - Environment Configuration
# Copy this file to .env and adjust values as needed.

# Server listen address (default: :8080)
LISTEN_ADDR=:8080

# Admin password for the control plane.
# If empty, a random password is generated on first start (development only).
ADMIN_PASSWORD=

# SQLite database file path (default: internal/store/fleet.db)
DATABASE_PATH=internal/store/fleet.db

# ACME / Let's Encrypt email for automatic certificate issuance
ACME_EMAIL=

# DNS provider credentials (AES-256-GCM encrypted at rest)
# DNS_PROVIDER=
# DNS_API_KEY=